{
  "rules": {
    ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
    ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        "profile": { ".write": "auth != null && auth.uid == $uid" },
        "property": { ".write": "auth != null && ((auth.uid == $uid && !data.exists()) || root.child('admins').child(auth.uid).val() == true)" },
        "taxes": { ".write": "auth != null && root.child('admins').child(auth.uid).val() == true" },
        "preferences": { ".write": "auth != null && auth.uid == $uid" },
        "bank": { ".write": "auth != null && auth.uid == $uid" },
        "school": {
          "registeredAt": { ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)" },
          "subjects": { ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)" },
          "grades": { ".write": "auth != null && root.child('admins').child(auth.uid).val() == true" }
        }
      }
    },
    "usernames": { "$name": { ".read": "auth != null", ".write": "auth != null && !data.exists() && newData.val() == auth.uid" } },
    "propertyEditRequests": { "$id": { ".read": "auth != null && (data.child('uid').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)", ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || root.child('admins').child(auth.uid).val() == true)" } },
    "taxPaymentRequests": { "$id": { ".read": "auth != null && (data.child('uid').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)", ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || root.child('admins').child(auth.uid).val() == true)" } },
    "admins": { "$uid": { ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)", ".write": "auth != null && root.child('admins').child(auth.uid).val() == true" } },
    "homeworks": { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).val() == true" },
    "homeworkAnswerKeys": { ".read": "auth != null && root.child('admins').child(auth.uid).val() == true", ".write": "auth != null && root.child('admins').child(auth.uid).val() == true" },
    "homeworkSubmissions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$homeworkId": { "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && !data.exists() && newData.hasChildren(['answers', 'submittedAt']) && !newData.child('grade').exists()"
      }}
    },
    "upcomingExams": { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).val() == true" },
    "announcements": { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).val() == true" },
    "bankCardNumbers": { "$number": { ".read": "auth != null", ".write": "auth != null && !data.exists() && newData.val() == auth.uid" } },
    "bankAccounts": { ".read": "auth != null", "$uid": { ".write": "auth != null && auth.uid == $uid" } },
    "bankTransfers": { "$recipientUid": { "$transferId": {
      ".read": "auth != null && (auth.uid == $recipientUid || data.child('senderUid').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)",
      ".write": "auth != null && ((!data.exists() && auth.uid == newData.child('senderUid').val() && newData.child('recipientUid').val() == $recipientUid && newData.child('amountCents').isNumber() && newData.child('amountCents').val() > 0 && newData.child('status').val() == 'pending') || (data.exists() && auth.uid == $recipientUid && data.child('status').val() == 'pending' && newData.child('status').val() == 'received' && newData.child('senderUid').val() == data.child('senderUid').val() && newData.child('recipientUid').val() == data.child('recipientUid').val() && newData.child('amountCents').val() == data.child('amountCents').val()))"
    } } }
  }
}
